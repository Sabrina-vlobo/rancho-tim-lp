# Copie para .env.local se quiser testar a versão "oficial" no seu computador.
# Na Cloudflare Pages, cadastre estas variáveis em Settings > Environment variables.

# Endereço final do site, sem barra no fim
NEXT_PUBLIC_SITE_URL=https://ranchotim.com.br

# "true" libera o Google. Deixe vazio (ou não cadastre) no link de teste.
NEXT_PUBLIC_INDEXAR=true
